def re_escape(s):
    return re.sub(r"([.^$*+?()\[\]{}|\\])", r"\\\1", s)


def guess_class(app):
    """Best-effort Hyprland class regex for a desktop entry."""
    wm = app.get_string("StartupWMClass")
    if wm and not wm.startswith("@@"):  # skip unsubstituted build placeholders
        return "(?i)" + re_escape(wm)
    cmd = app.get_commandline() or ""
    m = re.search(r"--app=\"?https?://([^/\"\s]+)", cmd) or re.search(
        r"omarchy-launch-webapp\s+\"?https?://([^/\"\s]+)", cmd
    )
    if m:  # Chromium --app windows: chrome-<host>__<path>-Default
        return "(?i)chrome-" + re_escape(m.group(1)) + "__.*"
    m = re.search(r"--app-id[= ]\"?([\w.\-]+)", cmd)
    if m:
        return re_escape(m.group(1))
    names = []
    app_id = (app.get_id() or "").removesuffix(".desktop")
    if app_id:
        names.append(app_id)
    exe = app.get_executable()
    if exe:
        base = os.path.basename(exe)
        if base not in names and base not in ("env", "sh", "bash", "flatpak", "uwsm-app"):
            names.append(base)
    if not names:
        return ""
    alts = "|".join(re_escape(n) for n in names)
    return f"(?i)({alts})" if len(names) > 1 else f"(?i){alts}"


def matcher(cfg):
    """Predicate for windows of an app: class regex (full match), plus optional title regex (full match)."""
    try:
        crx = re.compile(cfg.get("class") or "(?!)")
        trx = re.compile(cfg["title"]) if cfg.get("title") else None
    except re.error:
        return None
    return lambda c: bool(crx.fullmatch(c.get("class") or "")) and (trx is None or bool(trx.fullmatch(c.get("title") or "")))


def lua_str(s):
    level = "=" * 3
    while f"]{level}]" in s:
        level += "="
    return f"[{level}[{s}]{level}]"


def open_window_classes():
    try:
        out = subprocess.run(["hyprctl", "clients", "-j"], capture_output=True, text=True, timeout=3).stdout
        return sorted({(c.get("class") or "", c.get("title") or "") for c in json.loads(out) if c.get("class")})
    except Exception:
        return []


class State:
    def __init__(self):
        self.apps = {}  # desktop id -> {workspace, autostart, class}
        self.return_to = 1
        self.autostart_enabled = True  # master switch for "launch at login"
        try:
            with open(STATE_FILE) as f:
                data = json.load(f)
            self.apps = data.get("apps", {})
            self.return_to = data.get("return_to", 1)
            self.autostart_enabled = data.get("autostart_enabled", True)
        except (OSError, ValueError):
            pass
        for cfg in self.apps.values():  # older files stored a single "workspace"
            if "workspaces" not in cfg:
                cfg["workspaces"] = [cfg.pop("workspace")] if "workspace" in cfg else []
        self.apps = {a: c for a, c in self.apps.items() if c["workspaces"]}

    def has_multi(self):
        return any(len(c["workspaces"]) > 1 for c in self.apps.values())

    def save(self):
        with open(STATE_FILE, "w") as f:
            json.dump({"return_to": self.return_to, "autostart_enabled": self.autostart_enabled,
                       "apps": self.apps}, f, indent=2)


def launch_cmd(*argv):
    """Shell command that starts argv (a desktop entry ID or a program) in the session."""
    quoted = " ".join(shlex.quote(a) for a in argv)
    if shutil.which("uwsm-app"):  # UWSM sessions (Omarchy): proper systemd scope
        return f"uwsm-app -- {quoted}"
    if argv[0].endswith(".desktop"):
        return f"gtk-launch {shlex.quote(argv[0].removesuffix('.desktop'))}"
    return quoted


def virtual_apps():
    """Launchable things without a desktop entry, shown at the top of the list."""
    if hasattr(virtual_apps, "cache"):
        return virtual_apps.cache
    apps = {}
    if shutil.which("omarchy-agent"):  # Omarchy's default coding agent (Claude, Codex, ...)
        try:
            agent = subprocess.run(["omarchy-default-agent"], capture_output=True, text=True, timeout=3).stdout.strip()
        except Exception:
            agent = ""
        # `omarchy agent` windows are org.omarchy.agent; `tui =` bindings use org.omarchy.<binary>
        names = "agent" + (f"|{re_escape(agent)}" if agent else "")
        apps["omarchy-agent"] = {
            "name": f"Default agent ({agent})" if agent else "Default agent",
            # first icon the theme has wins; falls back to the usual terminals
            "icon": [agent or "agent", "utilities-terminal", "com.mitchellh.ghostty", "Alacritty", "kitty",
                     "foot", "org.gnome.Console", "application-x-executable"],
            "class": rf"org\.omarchy\.({names})",
            "launch": "omarchy-agent",
        }
    virtual_apps.cache = apps
    return apps


def app_launch_cmd(app_id):
    v = virtual_apps().get(app_id)
    return v["launch"] if v else launch_cmd(app_id)


def daemon_cmd():
    return launch_cmd(SELF, "--daemon")


def write_lua(state, names):
    lines = [
        "-- Generated by Workspace Apps (https://github.com/seatrips/hyprland-workspace-apps).",
        "-- Edits here are overwritten: use the app, or ~/.config/hypr/workspace-apps.json.",
        "",
    ]
    by_ws = sorted(state.apps.items(), key=lambda kv: (kv[1]["workspaces"][0], names.get(kv[0], kv[0]).lower()))
    for app_id, cfg in by_ws:
        if not cfg.get("class"):
            continue
        extra = ""
        if len(cfg["workspaces"]) > 1:
            extra = f"  (windows 2+ -> {', '.join(map(str, cfg['workspaces'][1:]))} via daemon)"
        lines.append(f"-- {names.get(app_id, app_id)}{extra}")
        match = f"class = {lua_str(cfg['class'])}"
        if cfg.get("title"):
            match += f", title = {lua_str(cfg['title'])}"
        lines.append(f'hl.window_rule({{ match = {{ {match} }}, workspace = "{cfg["workspaces"][0]}" }})')

    startup = []
    if state.has_multi():
        startup += ["  -- Moves 2nd/3rd/... windows of multi-workspace apps", f"  hl.exec_cmd({lua_str(daemon_cmd())})"]
    autostart = [a for a, c in by_ws if c.get("autostart")] if state.autostart_enabled else []
    if autostart:
        startup.append("  -- Launch at login")
        startup += [f"  hl.exec_cmd({lua_str(app_launch_cmd(a))})" for a in autostart]
        if state.return_to:
            cmd = f"sleep 4 && hyprctl dispatch 'hl.dsp.focus({{ workspace = \"{int(state.return_to)}\" }})'"
            startup.append(f"  hl.exec_cmd({lua_str(cmd)})")
    if startup:
        lines += ["", 'hl.on("hyprland.start", function()', *startup, "end)"]
    with open(LUA_FILE, "w") as f:
        f.write("\n".join(lines) + "\n")


def ensure_included():
    """Load workspace-apps.lua from hyprland.lua (once; backs the file up first)."""
    with open(MAIN_CONF) as f:
        text = f.read()
    if any(s in text for s in LEGACY_INCLUDES):
        return
    shutil.copy(MAIN_CONF, f"{MAIN_CONF}.bak.{int(time.time())}")
    anchor = 'require("hypr.autostart")'  # Omarchy: load right after the user's autostart
    if anchor in text:
        text = text.replace(anchor, f"{anchor}\n{INCLUDE_LINE}", 1)
    else:
        text = text.rstrip("\n") + f"\n\n{INCLUDE_LINE}\n"
    with open(MAIN_CONF, "w") as f:
        f.write(text)


def activate_now(state):
    """Start the ▶ apps that aren't running and move open windows to their workspaces.

    Returns (launched, moved) counts. Needs the window rules to be loaded already
    (i.e. after a save), so freshly launched apps land on their workspace.
    """
    try:
        clients = hypr_json("clients")
        mons = {m["id"]: (m["width"] / m["scale"], m["height"] / m["scale"]) for m in hypr_json("monitors")}
    except Exception:
        return 0, 0
    launched = moved = 0
    for app_id, cfg in state.apps.items():
        match = matcher(cfg)
        if not match:
            continue
        wins = [c for c in clients if match(c) and is_main_window(c, mons)]
        if not wins:
            if cfg.get("autostart"):
                subprocess.Popen(["setsid", "sh", "-c", app_launch_cmd(app_id)], stdout=subprocess.DEVNULL,
                                 stderr=subprocess.DEVNULL, start_new_session=True)
                launched += 1
            continue
        wss = [str(w) for w in cfg["workspaces"]]
        for i, c in enumerate(wins):
            target = wss[min(i, len(wss) - 1)]
            if str(c["workspace"]["name"]) != target:
                subprocess.run(["hyprctl", "dispatch",
                                f'hl.dsp.window.move({{ window = "address:{c["address"]}", workspace = "{target}", follow = false }})'],
                               capture_output=True, timeout=3)
                moved += 1
    if launched and state.return_to:
        subprocess.Popen(["setsid", "sh", "-c",
                          f"sleep 4 && hyprctl dispatch 'hl.dsp.focus({{ workspace = \"{int(state.return_to)}\" }})'"],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    return launched, moved


# ---------------- daemon ----------------

def hypr_json(*args):
    out = subprocess.run(["hyprctl", *args, "-j"], capture_output=True, text=True, timeout=3).stdout
    return json.loads(out)


def is_main_window(c, mon_sizes):
    """Skip dialogs/popups: floating windows that are clearly smaller than a screen."""
    if not c.get("mapped", True) or not c.get("title"):
        return False
    if not c.get("floating"):
        return True
    mw, mh = mon_sizes.get(c.get("monitor"), (1920, 1080))
    w, h = c["size"]
    return w >= mw * 0.6 and h >= mh * 0.6


def handle_open(addr, state):
    time.sleep(0.4)  # let the window settle (title, floating state)
    try:
        clients = hypr_json("clients")
        mons = {m["id"]: (m["width"] / m["scale"], m["height"] / m["scale"]) for m in hypr_json("monitors")}
    except Exception:
        return
    new = next((c for c in clients if c["address"].removeprefix("0x") == addr.removeprefix("0x")), None)
    if not new or not is_main_window(new, mons):
        return
    for cfg in state.apps.values():
        wss = cfg["workspaces"]
        if len(wss) < 2 or not cfg.get("class"):
            continue
        match = matcher(cfg)
        if not match or not match(new):
            continue
        taken = {str(c["workspace"]["name"]) for c in clients
                 if c["address"] != new["address"] and match(c) and is_main_window(c, mons)}
        target = next((str(w) for w in wss if str(w) not in taken), None)
        if target and target != str(new["workspace"]["name"]):
            subprocess.run(["hyprctl", "dispatch",
                            f'hl.dsp.window.move({{ window = "address:{new["address"]}", workspace = "{target}", follow = false }})'],
                           capture_output=True, timeout=3)
        return


def run_daemon():
    lock = open(LOCK_FILE, "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        return  # already running
    sock_path = os.path.join(os.environ["XDG_RUNTIME_DIR"], "hypr", os.environ["HYPRLAND_INSTANCE_SIGNATURE"], ".socket2.sock")
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.connect(sock_path)
    buf = b""
    state, mtime = None, None
    while True:
        chunk = s.recv(4096)
        if not chunk:
            return  # Hyprland exited
        buf += chunk
        *lines, buf = buf.split(b"\n")
        for line in lines:
            ev, _, data = line.decode(errors="replace").partition(">>")
            if ev != "openwindow":
                continue
            try:
                m = os.path.getmtime(STATE_FILE)
                if m != mtime:
                    state, mtime = State(), m
            except OSError:
                continue
            if state.has_multi():
                handle_open(data.split(",", 1)[0], state)


def daemon_running():
    try:
        with open(LOCK_FILE, "w") as f:
            fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
            fcntl.flock(f, fcntl.LOCK_UN)
        return False
    except OSError:
        return True


if len(sys.argv) > 1 and sys.argv[1] in ("-h", "--help"):
    print(__doc__.strip() + "\n\nUsage: workspace-apps            open the editor\n"
          "       workspace-apps --activate start the ▶ apps now and move open windows to their workspaces\n"
          "       workspace-apps --daemon   run the multi-window mover (started automatically)")
    sys.exit(0)
if len(sys.argv) > 1 and sys.argv[1] == "--daemon":
    run_daemon()
    sys.exit(0)
if len(sys.argv) > 1 and sys.argv[1] == "--activate":
    n_launched, n_moved = activate_now(State())
    print(f"started {n_launched} app(s), moved {n_moved} window(s)")
    sys.exit(0)

