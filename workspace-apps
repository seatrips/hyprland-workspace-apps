#!/usr/bin/env python3
"""Workspace Apps — pin installed apps to Hyprland workspaces.

Drag an app (or click it, then click a tile) onto a workspace. Saving writes
~/.config/hypr/workspace-apps.lua (window rules + optional autostart) and
reloads Hyprland. State lives in ~/.config/hypr/workspace-apps.json.

An app can own several workspaces: its 1st window goes to the first one, its
2nd window to the next, and so on. Window rules can't tell windows of the same
app apart, so `workspace-apps --daemon` (started at login) watches Hyprland's
event socket and moves the extra windows.
"""

import fcntl
import json
import os
import re
import shlex
import shutil
import socket
import subprocess
import sys
import time

HYPR_DIR = os.path.expanduser("~/.config/hypr")
STATE_FILE = os.path.join(HYPR_DIR, "workspace-apps.json")
LUA_FILE = os.path.join(HYPR_DIR, "workspace-apps.lua")
MAIN_CONF = os.path.join(HYPR_DIR, "hyprland.lua")
INCLUDE_LINE = 'dofile(os.getenv("HOME") .. "/.config/hypr/workspace-apps.lua") -- Workspace Apps'
LEGACY_INCLUDES = ('require("hypr.workspace-apps")', "workspace-apps.lua")
WORKSPACES = range(1, 11)
SELF = os.path.realpath(__file__)
APP_ID = "io.github.seatrips.WorkspaceApps"
LOCK_FILE = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "workspace-apps-daemon.lock")

