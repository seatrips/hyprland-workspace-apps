import gi  # noqa: E402

gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
gi.require_version("Pango", "1.0")
from gi.repository import Adw, Gdk, Gio, GObject, Gtk, Pango  # noqa: E402


def drag_source_for(widget, payload):
    src = Gtk.DragSource(actions=Gdk.DragAction.MOVE | Gdk.DragAction.COPY)
    src.connect("prepare", lambda *_: Gdk.ContentProvider.new_for_value(GObject.Value(str, payload)))
    src.connect("drag-begin", lambda s, _d: s.set_icon(Gtk.WidgetPaintable.new(widget), 20, 20))
    widget.add_controller(src)


class WorkspaceApps(Adw.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID)
        self.state = State()
        self.selected = None
        self.dirty = False

    # ---------- setup ----------
    def do_activate(self):
        if self.props.active_window:
            self.props.active_window.present()
            return
        css = Gtk.CssProvider()
        css.load_from_string(CSS)
        Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

        self.infos = {}
        for app in Gio.AppInfo.get_all():
            if app.should_show() and app.get_id():
                self.infos[app.get_id()] = app
        self.names = {k: v.get_display_name() for k, v in self.infos.items()}
        self.virtual = virtual_apps()
        self.names.update({k: v["name"] for k, v in self.virtual.items()})

        win = Adw.ApplicationWindow(application=self, title="Workspace Apps", default_width=1200, default_height=760)
        self.win = win
        self.toasts = Adw.ToastOverlay()
        view = Adw.ToolbarView()
        header = Adw.HeaderBar()
        self.save_btn = Gtk.Button(label="Save & Apply", css_classes=["suggested-action"])
        self.save_btn.connect("clicked", self.on_save)
        header.pack_end(self.save_btn)
        act = Gtk.Button(label="Activate now", tooltip_text="Save, start the ▶ apps that aren't running, "
                                                            "and move open windows to their workspaces")
        act.connect("clicked", self.on_activate)
        header.pack_end(act)

        login_box = Gtk.Box(spacing=8, margin_end=12)
        login_box.append(Gtk.Label(label="Start apps at login", css_classes=["hint"]))
        self.login_switch = Gtk.Switch(active=self.state.autostart_enabled, valign=Gtk.Align.CENTER,
                                       css_classes=["login-switch"],
                                       tooltip_text="Green: the ▶ apps start when you log in. Red: nothing starts.")
        self.login_state = Gtk.Label()
        self.login_switch.connect("notify::active", self.on_login_toggled)
        login_box.append(self.login_switch)
        login_box.append(self.login_state)
        self.update_login_label()
        header.pack_start(login_box)

        ret_box = Gtk.Box(spacing=6)
        ret_box.append(Gtk.Label(label="After login, go to", css_classes=["hint"]))
        self.ret_drop = Gtk.DropDown.new_from_strings(["stay put"] + [f"workspace {i}" for i in WORKSPACES])
        self.ret_drop.set_selected(int(self.state.return_to or 0))
        self.ret_drop.connect("notify::selected", self.on_return_changed)
        ret_box.append(self.ret_drop)
        header.pack_start(ret_box)
        view.add_top_bar(header)

        paned = Gtk.Paned(orientation=Gtk.Orientation.HORIZONTAL, position=300, shrink_start_child=False)
        paned.set_start_child(self.build_app_list())
        paned.set_end_child(self.build_tiles())
        view.set_content(paned)
        self.toasts.set_child(view)
        win.set_content(self.toasts)
        win.connect("close-request", self.on_close)
        self.refresh_tiles()
        win.present()

    def build_app_list(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8, margin_start=10, margin_end=6, margin_top=10, margin_bottom=10)
        self.search = Gtk.SearchEntry(placeholder_text="Search installed apps")
        self.search.connect("search-changed", lambda *_: self.app_list.invalidate_filter())
        box.append(self.search)
        self.hint = Gtk.Label(label="Drag an app onto a workspace — or click it, then click a tile. "
                              "Put an app on a 2nd tile to send its 2nd window there.", wrap=True, xalign=0, css_classes=["hint", "caption"])
        box.append(self.hint)

        self.app_list = Gtk.ListBox(css_classes=["navigation-sidebar"], selection_mode=Gtk.SelectionMode.SINGLE)
        self.app_list.set_filter_func(self.filter_row)
        for app_id in [*self.virtual, *sorted(self.infos, key=lambda k: self.names[k].lower())]:
            self.app_list.append(self.make_app_row(app_id))
        self.app_list.connect("row-selected", self.on_row_selected)
        scroller = Gtk.ScrolledWindow(vexpand=True, hscrollbar_policy=Gtk.PolicyType.NEVER, child=self.app_list)
        box.append(scroller)
        return box

    def make_app_row(self, app_id):
        row = Gtk.ListBoxRow()
        row.app_id = app_id
        h = Gtk.Box(spacing=10, css_classes=["app-row"])
        h.append(self.icon_for(app_id, 28))
        h.append(Gtk.Label(label=self.names[app_id], xalign=0, hexpand=True, ellipsize=Pango.EllipsizeMode.END))
        row.badge = Gtk.Label(css_classes=["dim-label", "caption"])
        h.append(row.badge)
        row.set_child(h)
        drag_source_for(row, f"add:{app_id}")
        return row

    def build_tiles(self):
        self.tiles = {}
        grid = Gtk.FlowBox(row_spacing=12, column_spacing=12, homogeneous=True, min_children_per_line=2,
                           max_children_per_line=5, selection_mode=Gtk.SelectionMode.NONE, valign=Gtk.Align.START,
                           margin_start=6, margin_end=12, margin_top=12, margin_bottom=12)
        for i in WORKSPACES:
            tile = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6, css_classes=["ws-tile"])
            tile.set_size_request(210, 260)
            tile.append(Gtk.Label(label=str(i), xalign=0, css_classes=["ws-number"]))
            body = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4, vexpand=True)
            tile.append(Gtk.ScrolledWindow(child=body, vexpand=True, hscrollbar_policy=Gtk.PolicyType.NEVER))
            tile.body = body

            drop = Gtk.DropTarget.new(GObject.TYPE_STRING, Gdk.DragAction.MOVE | Gdk.DragAction.COPY)
            drop.connect("drop", lambda _t, value, _x, _y, ws=i: self.on_drop(value, ws) or True)
            tile.add_controller(drop)
            click = Gtk.GestureClick()
            click.connect("released", lambda *_a, ws=i: self.selected and self.assign(self.selected, ws))
            tile.add_controller(click)

            self.tiles[i] = tile
            grid.append(tile)
        return Gtk.ScrolledWindow(child=grid, hexpand=True)

    # ---------- helpers ----------
    def icon_for(self, app_id, size):
        if app_id in self.virtual:
            img = Gtk.Image.new_from_gicon(Gio.ThemedIcon.new_from_names(self.virtual[app_id]["icon"]))
            img.set_pixel_size(size)
            return img
        app = self.infos.get(app_id)
        icon = app.get_icon() if app else None
        img = Gtk.Image.new_from_gicon(icon) if icon else Gtk.Image.new_from_icon_name("application-x-executable")
        img.set_pixel_size(size)
        return img

    def filter_row(self, row):
        q = self.search.get_text().lower()
        return not q or q in self.names[row.app_id].lower() or q in row.app_id.lower()

    def mark_dirty(self):
        self.dirty = True
        self.save_btn.set_label("Save & Apply •")

    # ---------- actions ----------
    def on_row_selected(self, _lb, row):
        self.selected = row.app_id if row else None
        for tile in self.tiles.values():
            tile.remove_css_class("armed") if not row else tile.add_css_class("armed")
        if row:
            self.hint.set_label(f"Now click a workspace for {self.names[row.app_id]}.")

    def on_drop(self, payload, ws):
        kind, _, rest = payload.partition(":")
        if kind == "move":  # chip dragged from another tile: move that one slot
            app_id, _, src = rest.rpartition(":")
            wss = self.state.apps.get(app_id, {}).get("workspaces", [])
            if int(src) in wss and ws not in wss:
                wss[wss.index(int(src))] = ws
                self.mark_dirty()
                self.refresh_tiles()
        elif kind == "add":
            self.assign(rest, ws)

    def assign(self, app_id, ws):
        """Add ws to the app's workspaces (a 2nd tile means 'its 2nd window goes here')."""
        cfg = self.state.apps.get(app_id)
        if cfg:
            if ws in cfg["workspaces"]:
                return
            cfg["workspaces"].append(ws)
            if len(cfg["workspaces"]) == 2:
                self.toasts.add_toast(Adw.Toast(
                    title=f"{self.names.get(app_id, app_id)}: window 1 → {cfg['workspaces'][0]}, window 2 → {ws}", timeout=4))
        else:
            app = self.infos.get(app_id)
            cls = self.virtual[app_id]["class"] if app_id in self.virtual else guess_class(app) if app else ""
            self.state.apps[app_id] = {"workspaces": [ws], "autostart": False, "class": cls}
        self.app_list.unselect_all()
        self.hint.set_label("Drag an app onto a workspace — or click it, then click a tile.")
        self.mark_dirty()
        self.refresh_tiles()

    def unassign(self, app_id, ws):
        cfg = self.state.apps.get(app_id)
        if cfg and ws in cfg["workspaces"]:
            cfg["workspaces"].remove(ws)
            if not cfg["workspaces"]:
                self.state.apps.pop(app_id)
        self.mark_dirty()
        self.refresh_tiles()

    def refresh_tiles(self):
        for ws, tile in self.tiles.items():
            child = tile.body.get_first_child()
            while child:
                nxt = child.get_next_sibling()
                tile.body.remove(child)
                child = nxt
            ids = sorted((a for a, c in self.state.apps.items() if ws in c["workspaces"]),
                         key=lambda a: self.names.get(a, a).lower())
            if not ids:
                tile.body.append(Gtk.Label(label="Drop apps here", css_classes=["ws-empty"], vexpand=True))
            for app_id in ids:
                tile.body.append(self.make_chip(app_id, ws))
        row = self.app_list.get_first_child()
        while row:
            cfg = self.state.apps.get(row.app_id)
            row.badge.set_label("→ " + ", ".join(map(str, cfg["workspaces"])) if cfg else "")
            row = row.get_next_sibling()

    def make_chip(self, app_id, ws):
        cfg = self.state.apps[app_id]
        chip = Gtk.Box(spacing=6, css_classes=["chip"])
        chip.append(self.icon_for(app_id, 20))
        names = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, hexpand=True)
        names.append(Gtk.Label(label=self.names.get(app_id, app_id), xalign=0, ellipsize=Pango.EllipsizeMode.END))
        if len(cfg["workspaces"]) > 1:
            n = cfg["workspaces"].index(ws) + 1
            names.append(Gtk.Label(label=f"window {n} of {len(cfg['workspaces'])}", xalign=0, css_classes=["dim-label", "caption"]))
        chip.append(names)

        if cfg["workspaces"][0] == ws:  # one launch-at-login toggle per app, on its first tile
            auto = Gtk.ToggleButton(icon_name="media-playback-start-symbolic", active=cfg.get("autostart", False),
                                    css_classes=["flat", "circular"], tooltip_text="Launch at login")

            def on_auto(b):
                cfg["autostart"] = b.get_active()
                self.mark_dirty()
            auto.connect("toggled", on_auto)
            chip.append(auto)

        gear = Gtk.MenuButton(icon_name="emblem-system-symbolic", css_classes=["flat", "circular"],
                              tooltip_text="Window match")
        gear.set_popover(self.make_match_popover(app_id))
        chip.append(gear)

        rm = Gtk.Button(icon_name="window-close-symbolic", css_classes=["flat", "circular"], tooltip_text="Remove")
        rm.connect("clicked", lambda *_: self.unassign(app_id, ws))
        chip.append(rm)

        if not cfg.get("class"):
            chip.set_tooltip_text("No window class — set one with the gear button")
            chip.add_css_class("error")
        drag_source_for(chip, f"move:{app_id}:{ws}")
        return chip

    def make_match_popover(self, app_id):
        cfg = self.state.apps[app_id]
        pop = Gtk.Popover()
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8, margin_start=10, margin_end=10, margin_top=10, margin_bottom=10)
        box.append(Gtk.Label(label="Window class (regex)", xalign=0, css_classes=["heading"]))
        entry = Gtk.Entry(text=cfg.get("class", ""), width_chars=36)

        def on_entry(e):
            cfg["class"] = e.get_text().strip()
            self.mark_dirty()
        entry.connect("changed", on_entry)
        box.append(entry)
        box.append(Gtk.Label(label="Window title (regex, optional)", xalign=0, css_classes=["heading"]))
        title_entry = Gtk.Entry(text=cfg.get("title", ""), width_chars=36, placeholder_text="any title")

        def on_title(e):
            t = e.get_text().strip()
            if t:
                cfg["title"] = t
            else:
                cfg.pop("title", None)
            self.mark_dirty()
        title_entry.connect("changed", on_title)
        box.append(title_entry)
        box.append(Gtk.Label(label="Only needed when other apps share the class\n(e.g. java-lang-Thread). Must match the whole title.",
                             xalign=0, css_classes=["hint", "caption"]))
        box.append(Gtk.Label(label="Guessed from the app. If it doesn't land on its\nworkspace, open the app and pick its window\n(T uses its title):",
                             xalign=0, css_classes=["hint", "caption"]))
        pick = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        box.append(pick)

        def fill(*_):
            child = pick.get_first_child()
            while child:
                nxt = child.get_next_sibling()
                pick.remove(child)
                child = nxt
            wins = open_window_classes()
            if not wins:
                pick.append(Gtk.Label(label="(no open windows)", xalign=0, css_classes=["dim-label"]))
            for cls, title in wins:
                row = Gtk.Box(spacing=2)
                b = Gtk.Button(css_classes=["flat"], hexpand=True, tooltip_text="Use this class")
                b.set_child(Gtk.Label(label=f"{cls}  —  {title[:40]}", xalign=0, ellipsize=Pango.EllipsizeMode.END))
                b.connect("clicked", lambda _b, c=cls: entry.set_text(re_escape(c)))
                row.append(b)
                tb = Gtk.Button(label="T", css_classes=["flat", "circular"], tooltip_text="Use this class and title")
                tb.connect("clicked", lambda _b, c=cls, t=title: (entry.set_text(re_escape(c)),
                                                                   title_entry.set_text(f"(?i).*{re_escape(t)}.*")))
                row.append(tb)
                pick.append(row)
        pop.connect("show", fill)
        pop.set_child(box)
        return pop

    def update_login_label(self):
        on = self.login_switch.get_active()
        self.login_state.set_label("ON" if on else "OFF")
        self.login_state.set_css_classes(["login-on" if on else "login-off"])

    def on_login_toggled(self, sw, _p):
        self.state.autostart_enabled = sw.get_active()
        self.update_login_label()
        self.mark_dirty()

    def on_activate(self, *_):
        if not self.on_save(quiet=True):
            return
        launched, moved = activate_now(self.state)
        if not launched and not moved:
            msg = ("Everything is already in place" if any(c.get("autostart") for c in self.state.apps.values())
                   else "Nothing to start: press ▶ on the apps you want started")
        else:
            msg = f"Started {launched} app(s), moved {moved} window(s)"
        self.toasts.add_toast(Adw.Toast(title=msg, timeout=4))

    def on_return_changed(self, drop, _p):
        self.state.return_to = drop.get_selected() or None
        self.mark_dirty()

    def on_save(self, *_, quiet=False):
        try:
            self.state.save()
            write_lua(self.state, self.names)
            ensure_included()
            subprocess.run(["hyprctl", "reload"], capture_output=True, timeout=5)
            if self.state.has_multi() and not daemon_running():
                subprocess.Popen(["setsid", "sh", "-c", daemon_cmd()], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
            errs = subprocess.run(["hyprctl", "configerrors"], capture_output=True, text=True, timeout=5).stdout.strip()
        except Exception as e:  # noqa: BLE001
            self.toasts.add_toast(Adw.Toast(title=f"Save failed: {e}", timeout=6))
            return False
        if errs and "no errors" not in errs.lower():
            self.toasts.add_toast(Adw.Toast(title=f"Saved, but Hyprland reports: {errs.splitlines()[0]}", timeout=8))
        elif not quiet:
            self.toasts.add_toast(Adw.Toast(title="Saved — apps will open on their workspaces"))
        self.dirty = False
        self.save_btn.set_label("Save & Apply")
        return True

    def on_close(self, win):
        if not self.dirty:
            return False
        dlg = Adw.AlertDialog(heading="Unsaved changes", body="Save your workspace layout before closing?")
        dlg.add_response("discard", "Discard")
        dlg.add_response("cancel", "Cancel")
        dlg.add_response("save", "Save")
        dlg.set_response_appearance("save", Adw.ResponseAppearance.SUGGESTED)
        dlg.set_response_appearance("discard", Adw.ResponseAppearance.DESTRUCTIVE)

        def done(d, res):
            r = d.choose_finish(res)
            if r == "save":
                self.on_save()
            if r in ("save", "discard"):
                self.dirty = False
                win.close()
        dlg.choose(win, None, done)
        return True


if __name__ == "__main__":
    WorkspaceApps().run(None)
